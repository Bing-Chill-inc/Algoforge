{
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": ["bun"],
		"verbatimModuleSyntax": true
	},
	"include": ["build.ts", "watch.ts", "src/runtime/config.ts"]
}
