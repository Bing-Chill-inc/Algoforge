{
	"name": "algoforge-editor",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun run build.ts",
		"build:dev": "bun run build.ts --development",
		"build:watch": "bun run watch.ts",
		"check": "bun run typecheck && bun run build && bun run test",
		"test": "bun test tests/editor.smoke.test.ts tests/documentController.test.ts",
		"typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.build.json"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@types/bun": "^1.3.3",
		"typescript": "^5.8.3"
	}
}
